{
  "name": "firestarter",
  "version": "0.6.4",
  "description": "Layered canvas studio for visual stories: manga, anime, posters, diagrams",
  "main": "main.js",
  "author": "Anuj Attri",
  "license": "SEE LICENSE IN ../LICENSE",
  "homepage": "https://github.com/Anuj-Attri/prod-imagen-studio",
  "desktopName": "firestarter.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "test": "node ../verify.js",
    "selftest": "node selftest.js",
    "e2e": "node e2e.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "konva": "^9.3.16",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.anujattri.firestarter",
    "productName": "Firestarter",
    "directories": {
      "output": "dist",
      "buildResources": "../build"
    },
    "files": [
      "main.js",
      "preload.js",
      "editor.html",
      "editor.js",
      "launcher.html",
      "launcher.js",
      "package.json",
      "node_modules/**/*",
      "deployment.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "../build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../build/icon.png",
      "category": "Graphics;2DGraphics;RasterGraphics",
      "synopsis": "Layered canvas studio for visual stories",
      "description": "A desktop drawing app for comics and illustration: a layered canvas with brush, shapes, guides and undo, and an agent panel that lays out pages, writes the dialogue into them and exports a chapter as one PDF.",
      "syncDesktopName": true,
      "maintainer": "Anuj Attri <anuj-attri@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OWNER",
        "repo": "prod-imagen-studio"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}